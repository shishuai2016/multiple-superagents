+/**
+ * Parse a deep link carried in the page URL, so an external tool can open one panel tab directly:
+ * `#execution`, `#execution?filter=person`, `#eval?window=24h`, `#trigger`, `#settings?group=prompts`.
+ * Falls back to `?tab=` for links whose fragment a redirect dropped.
+ */
+export function routeFromUrl(hash: string, search: string): Route | undefined {
+  const raw = hash.replace(/^#\/?/, '')
+  if (raw) {
+    const [path, query = ''] = raw.split('?')
+    const [page, id] = path.split('/').filter(Boolean)
+    const route = parseRoute({ page, id, query: Object.fromEntries(new URLSearchParams(query)) })
+    if (route) return route
+  }
+  const params = new URLSearchParams(search)
+  const tab = params.get('tab')
+  if (!tab) return undefined
+  return parseRoute({
+    page: tab,
+    query: {
+      filter: params.get('filter') ?? undefined,
+      group: params.get('group') ?? undefined,
+      window: params.get('window') ?? undefined,
+    },
+  })
+}
+
 export function initialLocation(): Location {
+  const linked = typeof location === 'undefined' ? undefined : routeFromUrl(location.hash, location.search)
+  if (linked) return { route: linked, stack: [], group: linked.page === 'settings' ? linked.query.group : undefined }
   try {
